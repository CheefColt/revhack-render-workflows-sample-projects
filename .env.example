# Copy to .env for local use. NEVER commit .env or paste keys into code.
# Set ONE provider key, or leave all blank to use the free built-in mock.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides
# LLM_PROVIDER=mock        # mock | gemini | anthropic | openai
# LLM_MODEL=

# Needed only to trigger DEPLOYED workflows from your own code
# RENDER_API_KEY=
# WORKFLOW_SLUG=launch-pack   # or site-health-checker; shown on your workflow's page
